# Defaults work without credentials or a model.
TRIAGE_MODE=replay
TRIAGE_ADDR=127.0.0.1:3000
TRIAGE_DB=.runtime/triage.redb
HTTP_CONCURRENCY=64
# Used only with TRIAGE_MODE=ollama. Set environment directly (no dotenv loader).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_CONCURRENCY=4
MODEL_TIMEOUT_MS=8000

