# Defaults work without credentials or a model.
TRIAGE_MODE=replay
TRIAGE_ADDR=127.0.0.1:3000
TRIAGE_DB=.runtime/triage.redb
HTTP_CONCURRENCY=64
# Copy to .env; environment variables override this literal local file.
# Used only with TRIAGE_MODE=ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_CONCURRENCY=4
ANALYSIS_CACHE_NAMESPACE=singletenant
ANALYSIS_CACHE_CAPACITY=256
ANALYSIS_CACHE_TTL_SECS=300
# Default timeout: Ollama 8000ms, DeepSeek 15000ms.
# MODEL_TIMEOUT_MS=15000
# Used only with TRIAGE_MODE=deepseek. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=512
# Limits apply per process, including retries. 1 USD = 1,000,000,000 nano USD.
DEEPSEEK_MAX_CALLS=100
DEEPSEEK_MAX_COST_NANO_USD=1000000000
# Estimated peak prices, nano USD/token; override when pricing/model changes.
DEEPSEEK_INPUT_MISS_NANO=300
DEEPSEEK_INPUT_HIT_NANO=6
DEEPSEEK_OUTPUT_NANO=1200

